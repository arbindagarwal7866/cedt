 "legacy_headers": {
  "alloc.h": {
   "fix": [
    "Use `#include <stdlib.h>` for malloc/calloc/free."
   ],
   "what": "alloc.h is an old Turbo C header."
  },
  "bits/stdc++.h": {
   "fix": [
    "Replace it with the headers you actually use, e.g. `#include <iostream>`, `#include <vector>`, `#include <algorithm>`, `#include <string>`.",
    "Or install real GCC (e.g. `brew install gcc`) and compile with g++-14."
   ],
   "what": "<bits/stdc++.h> is a GCC-only shortcut header that includes the whole C++ library. Clang on macOS (and MSVC) do not have it."
  },
  "conio.h": {
   "fix": [
    "Delete the line `#include <conio.h>`.",
    "Remove `clrscr();` (it only cleared the old DOS screen).",
    "Replace `getch();` with `getchar();` (from stdio.h) if you want to pause for a key."
   ],
   "what": "conio.h is an old Turbo C / MS-DOS header. It is not part of standard C, so GCC on Linux/macOS (and most online judges) do not have it."
  },
  "dos.h": {
   "fix": [
    "Remove it. For a pause use sleep() from <unistd.h> (Linux/macOS) or Sleep() from <windows.h> (Windows)."
   ],
   "what": "dos.h is an MS-DOS specific header (functions like delay() and sound()). It is not standard C."
  },
  "fstream.h": {
   "fix": [
    "Use `#include <fstream>` and `using namespace std;`."
   ],
   "what": "fstream.h is the old Turbo C++ version of <fstream>."
  },
  "graphics.h": {
   "fix": [
    "Use the lab's Turbo C setup for graphics programs, or install a port such as WinBGIm (Windows only).",
    "For console programs simply remove the include."
   ],
   "what": "graphics.h belongs to Borland's BGI graphics library from Turbo C. Modern compilers do not ship it."
  },
  "iomanip.h": {
   "fix": [
    "Use `#include <iomanip>` and `using namespace std;`."
   ],
   "what": "iomanip.h is the old Turbo C++ version of <iomanip>."
  },
  "iostream.h": {
   "fix": [
    "Write `#include <iostream>` (without .h).",
    "Add `using namespace std;` below the includes, or write std::cout / std::cin."
   ],
   "what": "iostream.h is the pre-1998 Turbo C++ header. Modern C++ compilers only have <iostream> (no .h), and its names live inside the std namespace."
  },
  "malloc.h": {
   "fix": [
    "Use `#include <stdlib.h>` for malloc/calloc/free."
   ],
   "what": "malloc.h is not a standard header and does not exist on macOS."
  },
  "process.h": {
   "fix": [
    "Use exit() from <stdlib.h>."
   ],
   "what": "process.h is a Windows/Turbo C header and is not standard."
  },
  "stdafx.h": {
   "fix": [
    "Remove the line."
   ],
   "what": "stdafx.h is a Visual Studio pre-compiled header, not part of C/C++."
  },
  "values.h": {
   "fix": [
    "Use <limits.h> (INT_MAX ...) or <float.h> instead."
   ],
   "what": "values.h is an obsolete header."
  },
  "windows.h": {
   "fix": [
    "Remove Windows-only calls such as Sleep() or system(\"cls\"), or compile on Windows."
   ],
   "what": "windows.h only exists on Windows compilers (MinGW / Visual Studio)."
  }
 },
